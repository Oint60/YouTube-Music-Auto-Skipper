{
  "name": "streamdeck-plugin",
  "version": "1.0.0",
  "description": "Stream Deck Plugin for NosTune",
  "main": "src/plugin.js",
  "scripts": {
    "build": "esbuild src/plugin.js --bundle --platform=node --target=node20 --outfile=com.nostune.streamdeck.sdPlugin/bin/plugin.js",
    "validate": "streamdeck validate com.nostune.streamdeck.sdPlugin",
    "pack": "npm run build && streamdeck pack com.nostune.streamdeck.sdPlugin --output ../dist --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
